{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muzik Calar",
  "version": "../package.json",
  "identifier": "io.github.gozlemesevdalisi.muzikcalar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Müzik Çalar",
        "width": 1200,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "backgroundColor": "#040506"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Music",
    "shortDescription": "Görselleri şarkıyı önceden bilen müzik çalar",
    "copyright": "GPL-3.0",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
